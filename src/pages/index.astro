---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../lib/slug';

const email = 'afif.mto@gmail.com';

const projects = (await getCollection('projects', ({ data }) => data.publish !== false)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);

const items = projects.map((p, i) => {
  const d = p.data;
  const links = [
    [d.links.live, 'Live ↗'],
    [d.links.demo, 'Demo ↗'],
    [d.links.repo, 'Code ↗'],
    [d.links.video, 'Video ↗'],
    [d.links.poster, 'Poster ↗'],
    [d.links.doc, 'Description ↗'],
  ]
    .filter(([u]) => u && u.length)
    .map(([href, label]) => ({ href, label }));
  return { d, slug: slugify(d.title), idx: String(i + 1).padStart(2, '0'), links, wip: d.status === 'wip' };
});
const total = String(items.length).padStart(2, '0');
---
<Layout loader={true}>
  <section id="hero" class="wrap">
    <div class="hero-kicker mono rv"><span>Design &amp; AI — SUTD</span><span class="dot">●</span><span>Singapore</span></div>
    <h1 class="big rv" data-bulge="">Afif</h1>
    <div class="hero-sub">
      <p class="rv">
        <strong>Design &amp; Artificial Intelligence student</strong> at SUTD and co-founder of Qojix. I build AI
        products end to end — model to interface to infrastructure.
      </p>
      <div class="hero-facts rv">
        <span class="mono">Currently — Qojix</span>
        <span class="mono">Available — <a href={`mailto:${email}`} style="color:var(--accent)">{email}</a></span>
      </div>
    </div>
  </section>

  <section id="work" class="wrap">
    <div class="sec-head rv">
      <h2>Selected Work</h2>
      <span class="mono">{total} Projects</span>
    </div>

    {
      items.map((it) => (
        <article class="row rv">
          <div class="row-top">
            <span class="idx">{it.idx}</span>
            <span class:list={['chip', { live: it.wip }]}>
              <i />
              {it.wip ? 'In progress' : 'Completed'}
            </span>
            <span class="yr">{it.d.year}</span>
          </div>
          <h3 class="ptitle">
            <a href={`/projects/${it.slug}`} data-bulge="">
              {it.d.title}
            </a>
          </h3>
          <div class="row-grid">
            <div>
              <p class="sum">{it.d.summary}</p>
              <div class="plinks">
                {it.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label}
                  </a>
                ))}
                <a class="more" href={`/projects/${it.slug}`}>
                  Case study →
                </a>
              </div>
            </div>
            <div class="row-meta">
              {it.d.role && (
                <span class="role-line">
                  <b>{it.d.role}</b>
                </span>
              )}
              <ul class="stack">
                {it.d.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section id="about" class="wrap">
    <div class="grid">
      <h2 class="disp rv" data-bulge="">About</h2>
      <div class="txt rv">
        <p>
          I'm Afif, a Design &amp; Artificial Intelligence student at the Singapore University of Technology and Design,
          and co-founder of <strong>Qojix</strong> — an AI assistant that handles WhatsApp and voice conversations for
          real-estate agents.
        </p>
        <p>
          I like owning the whole stack of a product: the model behavior, the interface, the firmware when there is
          firmware, and the deployment. Most of my work sits where AI meets a real workflow — agents answering leads,
          staff sanitizing a cleanroom, someone decoding a government letter.
        </p>
        <div class="now">
          <span class="mono">Now — Building Qojix</span>
          <span class="mono">School — SUTD, Design &amp; AI</span>
          <span class="mono">Contact — {email}</span>
        </div>
      </div>
    </div>
  </section>

  <footer id="contact" class="wrap">
    <p class="mono rv" style="margin-bottom:20px">Get in touch</p>
    <a class="mail rv" href={`mailto:${email}`}>{email}</a>
    <div class="foot-row">
      <span class="mono">© 2026 Afif</span>
      <span class="mono">Set in Archivo Variable</span>
    </div>
  </footer>
</Layout>
