---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = await getCollection('projects', ({ data }) => data.publish !== false);
// completed first, then wip; stable otherwise
const order = { completed: 0, wip: 1 } as const;
projects.sort((a, b) => order[a.data.status] - order[b.data.status]);
---
<Base title="Projects — Afif">
  <section class="pt-6">
    <h1 class="text-3xl font-semibold tracking-tight">Projects</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-400">Things I've built and things in progress.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {projects.map((p) => (
        <ProjectCard title={p.data.title} summary={p.data.summary} status={p.data.status} stack={p.data.stack} cover={p.data.cover} />
      ))}
    </div>
  </section>
</Base>
