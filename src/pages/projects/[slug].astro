---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.publish !== false);
  return projects.map((entry) => ({
    params: { slug: slugify(entry.data.title) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const statusLabel = d.status === 'wip' ? 'In progress' : 'Completed';
const linkList = [
  { url: d.links.live, label: 'Live' },
  { url: d.links.demo, label: 'Demo' },
  { url: d.links.repo, label: 'Code' },
  { url: d.links.video, label: 'Video' },
].filter((l) => l.url && l.url.length > 0);
---
<Base title={`${d.title} — Afif`} description={d.summary}>
  <article class="pt-6">
    <a href="/projects" class="text-sm text-neutral-500 underline underline-offset-2 hover:text-neutral-900 dark:hover:text-neutral-100">← Projects</a>

    <div class="mt-4 flex items-center gap-3">
      <h1 class="text-3xl font-semibold tracking-tight">{d.title}</h1>
      <span class:list={["rounded-full px-2 py-0.5 text-xs", d.status === 'wip' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300']}>{statusLabel}</span>
    </div>
    <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-300">{d.summary}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400">
      {d.role && <div><dt class="inline font-medium text-neutral-700 dark:text-neutral-300">Role:</dt> <dd class="inline">{d.role}</dd></div>}
      {d.year && <div><dt class="inline font-medium text-neutral-700 dark:text-neutral-300">Year:</dt> <dd class="inline">{d.year}</dd></div>}
    </dl>

    {d.stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {d.stack.map((s) => (
          <li class="rounded-md bg-neutral-100 px-2 py-1 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">{s}</li>
        ))}
      </ul>
    )}

    {linkList.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-3">
        {linkList.map((l) => (
          <a href={l.url} target="_blank" rel="noopener" class="rounded-lg border border-neutral-300 px-3 py-1.5 text-sm transition-colors hover:border-neutral-500 dark:border-neutral-700 dark:hover:border-neutral-500">{l.label} ↗</a>
        ))}
      </div>
    )}

    <div class="md mt-10 border-t border-neutral-200 pt-8 dark:border-neutral-800">
      <Content />
    </div>
  </article>
</Base>
