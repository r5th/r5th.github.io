---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => data.publish !== false)).sort(
    (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
  );
  const total = String(projects.length).padStart(2, '0');
  return projects.map((entry, i) => ({
    params: { slug: slugify(entry.data.title) },
    props: { entry, idx: String(i + 1).padStart(2, '0'), total },
  }));
}

const { entry, idx, total } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const wip = d.status === 'wip';
const links = [
  [d.links.live, 'Live ↗'],
  [d.links.demo, 'Demo ↗'],
  [d.links.repo, 'Code ↗'],
  [d.links.video, 'Video ↗'],
  [d.links.poster, 'Poster ↗'],
  [d.links.doc, 'Description ↗'],
]
  .filter(([u]) => u && u.length)
  .map(([href, label]) => ({ href, label }));
---
<Layout title={`${d.title} — Afif`} description={d.summary}>
  <article class="pp">
    <div class="wrap">
      <a class="back" href="/">← Index</a>
      <header class="pp-head">
        <p class="crumb mono rv">
          Project {idx} / {total} — {wip ? <span style="color:var(--accent)">In progress</span> : 'Completed'}
        </p>
        <h1 class="ptitle rv" data-bulge="">{d.title}</h1>
        <p class="pp-sum rv">{d.summary}</p>
        <dl class="pp-meta rv">
          <div>
            <dt>Status</dt>
            <dd>{wip ? 'In progress' : 'Completed'}</dd>
          </div>
          {d.role && (
            <div>
              <dt>Role</dt>
              <dd>{d.role}</dd>
            </div>
          )}
          {d.year && (
            <div>
              <dt>Year</dt>
              <dd>{d.year}</dd>
            </div>
          )}
          {links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd>
                <div class="plinks">
                  {links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  ))}
                </div>
              </dd>
            </div>
          )}
          <div style="grid-column:1/-1">
            <dt>Stack</dt>
            <dd>
              <ul class="stack">
                {d.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </header>
      <div class="body rv">
        <Content />
      </div>
      {d.shots.length > 0 && (
        <section class="shots rv" aria-label="Screenshots">
          {d.shots.map((s, i) => (
            <figure class="shot">
              <img
                src={s.src}
                alt={s.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="1600"
                height="900"
              />
              {s.caption && <figcaption>{s.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )}
    </div>
  </article>
</Layout>

<style>
  .shots {
    margin-top: 3.5rem;
    display: grid;
    gap: 1.75rem;
  }
  /* Two up from tablet width. The first shot stays full width: it is the
     establishing image and loses too much at half size. */
  @media (min-width: 720px) {
    .shots {
      grid-template-columns: 1fr 1fr;
    }
    .shot:first-child {
      grid-column: 1 / -1;
    }
  }
  .shot {
    margin: 0;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    background: #0b0e17; /* the game's own night sky, so a slow load is not a white flash */
  }
  .shot figcaption {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    line-height: 1.5;
    opacity: 0.68;
  }
</style>
