---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Afif', description = 'Afif — Design & AI student and co-founder of Qojix. Projects and portfolio.' } = Astro.props;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
];
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-white text-neutral-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a href="/" class="font-semibold tracking-tight">Afif</a>
      <ul class="flex gap-6 text-sm">
        {nav.map((n) => (
          <li><a href={n.href} class="text-neutral-500 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">{n.label}</a></li>
        ))}
      </ul>
    </nav>
    <main class="mx-auto max-w-3xl px-6 pb-24">
      <slot />
    </main>
    <footer class="mx-auto max-w-3xl px-6 py-10 text-sm text-neutral-500 dark:text-neutral-400">
      <span>© {new Date().getFullYear()} Afif · <a href="mailto:afif@qojix.com" class="underline underline-offset-2">afif@qojix.com</a></span>
    </footer>
  </body>
</html>
