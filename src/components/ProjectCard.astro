---
import { slugify } from '../lib/slug';

interface Props {
  title: string;
  summary: string;
  status: 'wip' | 'completed';
  stack: string[];
  cover?: string;
}
const { title, summary, status, stack, cover } = Astro.props;
const href = `/projects/${slugify(title)}`;
const statusLabel = status === 'wip' ? 'In progress' : 'Completed';
// vault covers are ./_img/x.png; publish maps them to /projects/x.png
const coverSrc = cover ? cover.replace('./_img/', '/projects/') : null;
---
<a href={href} class="group block rounded-xl border border-neutral-200 p-5 transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600">
  {coverSrc && <img src={coverSrc} alt={title} class="mb-4 aspect-video w-full rounded-lg object-cover" />}
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-semibold tracking-tight">{title}</h3>
    <span class:list={["shrink-0 rounded-full px-2 py-0.5 text-xs", status === 'wip' ? 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300' : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300']}>{statusLabel}</span>
  </div>
  <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{summary}</p>
  {stack.length > 0 && (
    <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-500">{stack.slice(0, 5).join(' · ')}</p>
  )}
</a>
